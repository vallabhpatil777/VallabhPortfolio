{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.netlify.tsbuildinfo",
    "target": "ES2022",
    /* DOM supplies the Request/Response/fetch/AbortSignal types the Netlify
       Functions v2 runtime exposes. */
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "composite": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /* The prompt module is shared with the React app; it is listed here so this
     project can typecheck the import without a cross-project reference. */
  "include": ["netlify/**/*.mts", "src/data/assistantPrompt.ts"]
}
