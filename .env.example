# --- Assistant (Groq) ---------------------------------------------------------
#
# GROQ_API_KEY is the one that matters. It has NO `VITE_` prefix, so Vite never
# compiles it into the client bundle: only the Netlify Function at
# `netlify/functions/chat.mts` reads it, and the browser talks to /api/chat.
#
# On Netlify: Site configuration -> Environment variables -> add GROQ_API_KEY.
# Do NOT add VITE_GROQ_API_KEY there — anything `VITE_`-prefixed ends up readable
# in devtools.
#
# Locally, `netlify dev` picks this up and runs the real function.
GROQ_API_KEY=

# Optional, local development only. Setting this makes `npm run dev` call Groq
# straight from the browser so the assistant works without the Netlify CLI.
# The branch that uses it is behind `import.meta.env.DEV` and is stripped from
# production builds. Never set this on Netlify.
VITE_GROQ_API_KEY=

# --- Contact form (Web3Forms) -------------------------------------------------
#
# REQUIRED — the contact form does not send without it.
#
# Get one free at https://web3forms.com: enter the address you want submissions
# delivered to, and the access key is emailed to you. No account, no OAuth.
#
# Public by design (it only permits posting to your one configured destination),
# which is why it carries the `VITE_` prefix and ships in the client bundle —
# the same trust model the old EmailJS public key had.
#
# This replaced EmailJS, whose Gmail service used OAuth: Google expires the
# refresh token every 7 days while the consent screen is in "Testing", and the
# form had been failing with `412 Gmail_API: Invalid grant` as a result.
#
# Set it in BOTH places:
#   - locally, in `.env`
#   - on Netlify: Site configuration -> Environment variables
VITE_WEB3FORMS_ACCESS_KEY=
