# Groq API key for the portfolio assistant.
# WARNING: `VITE_`-prefixed variables are embedded in the client bundle and are
# readable by anyone who opens devtools. Fine for a personal demo key with tight
# rate limits; for anything else, proxy the call through a serverless function
# that keeps the key server-side.
VITE_GROQ_API_KEY=

# EmailJS contact form. These identifiers are public by design.
# Defaults are baked into the code, so these are only needed to point the form
# at a different EmailJS account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
