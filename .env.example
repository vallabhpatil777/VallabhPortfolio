# --- Assistant (Groq) ---------------------------------------------------------
#
# GROQ_API_KEY is the one that matters. It has NO `VITE_` prefix, so Vite never
# compiles it into the client bundle: only the Netlify Function at
# `netlify/functions/chat.mts` reads it, and the browser talks to /api/chat.
#
# On Netlify: Site configuration -> Environment variables -> add GROQ_API_KEY.
# Do NOT add VITE_GROQ_API_KEY there — anything `VITE_`-prefixed ends up readable
# in devtools.
#
# Locally, `netlify dev` picks this up and runs the real function.
GROQ_API_KEY=

# Optional, local development only. Setting this makes `npm run dev` call Groq
# straight from the browser so the assistant works without the Netlify CLI.
# The branch that uses it is behind `import.meta.env.DEV` and is stripped from
# production builds. Never set this on Netlify.
VITE_GROQ_API_KEY=

# --- EmailJS contact form -----------------------------------------------------
# These identifiers are public by design.
# Defaults are baked into the code, so these are only needed to point the form
# at a different EmailJS account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
